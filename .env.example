# Generate with: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=your-secret-key-here-must-be-at-least-64-characters-long-change-this

# SQLite for local development; switch to PostgreSQL for production.
# Example PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/shortener
DATABASE_URL=sqlite+aiosqlite:///./data/shortener.db

# Redis auth password — MUST change before deploying.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=changeme

# Set to "production" for prod deployments (docker-compose.yml defaults to production).
# Affects: Secure cookie flag, HSTS header, API docs (/docs /redoc) exposure.
# Change to "production" here when deploying with this file as your .env.
APP_ENV=development

DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=changeme1234
# Optional: username for the default user (login still uses email)
DEFAULT_USER_USERNAME=admin

# Set to "true" to allow public self-registration.
# When unset or "false" (default), only admins can create accounts via the dashboard.
# ALLOW_REGISTRATION=false

# Comma-separated list of allowed CORS origins. Required in production.
# Example: http://yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost

# Comma-separated hostnames accepted in the Host header. Optional — in
# production this is derived from CORS_ALLOWED_ORIGINS above when unset, so
# you only need to set it if the backend is reached under a different host
# than your frontend origins.
# Example: ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=

# REQUIRED in production — your Docker bridge/overlay subnet for nginx→backend traffic.
# The server refuses to start in production if this is empty: without it the real
# client IP can't be resolved and all requests share one rate-limit bucket.
# Find with: docker network inspect <project>_app-net --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Example: TRUSTED_PROXY_CIDRS=172.18.0.0/16
TRUSTED_PROXY_CIDRS=

# Host port to expose the frontend on (default: 80).
# Example: HOST_PORT=5474
HOST_PORT=80
